{
  "license": "ISC",  
  "scripts": {
    "deploy:devnet": "solana program deploy --with-compute-unit-price 1000000  --max-sign-attempts 1000 --url https://api.devnet.solana.com --keypair ./wallets/deployer_devnet.json --upgrade-authority ./wallets/deployer_devnet.json --program-id ./wallets/cosmicgate.json target/deploy/cosmicgate.so",
    "resume:devnet": "solana program deploy --with-compute-unit-price 1000000  --max-sign-attempts 1000 --url https://api.devnet.solana.com --keypair ./wallets/deployer_devnet.json --upgrade-authority ./wallets/deployer_devnet.json --program-id ./wallets/cosmicgate.json target/deploy/cosmicgate.so --buffer ./wallets/recovered-buffer.json",
    "deploy:mainnet": "solana program deploy --with-compute-unit-price 1000000  --max-sign-attempts 1000 --url https://api.mainnet-beta.solana.com --keypair ./wallets/deployer_mainnet.json --upgrade-authority ./wallets/deployer_mainnet.json --program-id ./wallets/cosmicgate.json target/deploy/cosmicgate.so",
    "resume:mainnet": "solana program deploy --with-compute-unit-price 1000000  --max-sign-attempts 1000 --url https://api.mainnet-beta.solana.com --keypair ./wallets/deployer_mainnet.json --upgrade-authority ./wallets/deployer_mainnet.json --program-id ./wallets/cosmicgate.json target/deploy/cosmicgate.so --buffer ./wallets/recovered-buffer.json",
    "run_validator": "solana-test-validator --bpf-program CoREENxT6tW1HoK8ypY1SxRMZTcVPm7R94rH4PZNhX7d ./deps/mpl-core.so --reset",
    "update:localnet": "solana program deploy --with-compute-unit-price 1000000  --max-sign-attempts 1000 --url http://127.0.0.1:8899 --keypair ./wallets/deployer_devnet.json --upgrade-authority ./wallets/deployer_devnet.json --program-id ./wallets/cosmicgate.json ./target/deploy/cosmicgate.so"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1"
  },
  "devDependencies": {
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "typescript": "^4.3.5",
    "prettier": "^2.6.2"
  }
}
